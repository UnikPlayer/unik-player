# UnikPlayer Development Configuration
# Copy this file to .env and adjust as needed

# Set DEV_MODE=true to use local paths instead of %LOCALAPPDATA%
# Set DEV_MODE=false for production behavior
DEV_MODE=true

# Local data directory (relative to backend-csharp/UnikPlayer/)
# Used when DEV_MODE=true
# Contains: player-styles.json, css/*.css
DEV_DATA_DIR=../../dev-data
